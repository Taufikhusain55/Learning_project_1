<% layout("/layouts/boilerplate") %>

<body>
    <h3>Create a new Listing</h3>
    <form action="/listings" method="POST">
        Title : <input type="text" name="listing[title]" placeholder="Enter title">
        <br><br><br>
        <textarea type="text" name="listing[description]" placeholder="Enter description"></textarea>
        <br><br><br>
        Add image : <input type="text" name="listing[image]" placeholder="Enter URL/Link">
        <br><br><br>
        Pricing : <input type="number" name="listing[price]" placeholder="Enter price">
        <br><br><br>
        Location : <input type="text" name="listing[location]" placeholder="Enter Location">
        <br><br><br>
        Country : <input type="text" name="listing[country]" placeholder="Enter country">
        <br><br><br><br>
        <button>Submit</button>
    </form>
</body>
