<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
<h3>Edit your Listing</h3>
    <form action="/listings/<%= updatedListing.id %>?_method=PUT" method="POST">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input 
            type="text" 
            name="listing[title]" 
            value="<%= updatedListing.title %>"
            class="form-control"
            />
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea 
            name="listing[description]"
            class="form-control">
            <%= updatedListing.description %>            
            </textarea>
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input 
            type="text" 
            name="listing[image][url]" 
            value="<%= updatedListing.image.url %>"
            class="form-control">
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input 
                type="number" 
                name="listing[price]" 
                value="<%= updatedListing.price %>"
                class="form-control">
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input 
                type="text" 
                name="listing[country]" 
                value="<%= updatedListing.country %>"
                class="form-control">
            </div>
        </div>           



        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input 
            type="text" 
            name="listing[location]" 
            value="<%= updatedListing.location %>"
            class="form-control">
        </div>

        

        
        <button class="btn btn-dark edit-btn mt-3 mb-3">Save</button>
       
    </form>
    </div>
</div>